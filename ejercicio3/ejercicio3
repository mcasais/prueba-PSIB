import numpy as np
import matplotlib.pyplot as plt
import scipy.stats as stats
import pandas as pd

np.random.seed(42)

# ----------------------------------------------------------------------
# Parámetros del proceso
# ----------------------------------------------------------------------
A = 2
f0 = 5

# ========================================================================
# PARTE 1: Autocorrelación TEÓRICA de X(t) = A·cos(2πf0t + Φ)
# ========================================================================

def autocorrelacion_teorica_X(tau, A=A, f0=f0):
    """
    Calcula R_X(tau) = E[X(t)X(t+tau)] de forma analítica.

    Deducción:
    X(t)X(t+tau) = A^2 cos(2*pi*f0*t + phi) * cos(2*pi*f0*(t+tau) + phi)

    Usando la identidad cos(a)cos(b) = 1/2[cos(a-b) + cos(a+b)]:

    X(t)X(t+tau) = (A^2/2)[cos(2*pi*f0*tau) + cos(2*pi*f0*(2t+tau) + 2*phi)]

    Al tomar el valor esperado sobre Phi ~ Uniforme[0, 2*pi], el segundo
    término se cancela (integral de un coseno sobre un ciclo completo de
    fase = 0), quedando:

        R_X(tau) = (A^2 / 2) * cos(2*pi*f0*tau)
    """
    return (A**2 / 2) * np.cos(2 * np.pi * f0 * tau)


tau_vals = np.linspace(-2, 2, 800)
R_X_teorica = autocorrelacion_teorica_X(tau_vals)

plt.figure(figsize=(12, 5))
plt.plot(tau_vals, R_X_teorica, color="red", linewidth=2)
plt.title(r"Autocorrelación teórica $R_X(\tau) = \frac{A^2}{2}\cos(2\pi f_0 \tau)$")
plt.xlabel(r"$\tau$ (s)")
plt.ylabel(r"$R_X(\tau)$")
plt.grid(alpha=0.3)
plt.axhline(0, color="gray", linewidth=0.8)
plt.tight_layout()
plt.savefig("autocorrelacion_X_teorica.png", dpi=150)
plt.show()


# ========================================================================
# PARTE 2: Autocorrelación EMPÍRICA a partir de una realización larga
# ========================================================================

def autocorrelacion_empirica(x, dt, tau_max):
    """
    Calcula la autocorrelación empírica (promedio temporal) de una señal
    x muestreada con paso dt, para retardos tau en [-tau_max, tau_max].

    Se asume que el proceso es ergódico en media y autocorrelación, es
    decir, que el promedio temporal de una única realización larga es un
    buen estimador del promedio de ensamble E[X(t)X(t+tau)].

    Estimador (no sesgado):
        R_hat[k] = (1 / (N - k)) * sum_{n=0}^{N-k-1} x[n] * x[n+k]

    Retorna: (tau_array, R_hat_array)
    """
    N = len(x)
    k_max = int(round(tau_max / dt))
    k_max = min(k_max, N - 1)

    R_pos = np.zeros(k_max + 1)
    for k in range(k_max + 1):
        R_pos[k] = np.mean(x[: N - k] * x[k:])

    # La autocorrelación de un proceso real y estacionario es simétrica:
    # R(-tau) = R(tau). Reconstruimos el lado negativo por simetría.
    R_neg = R_pos[::-1]
    R_completa = np.concatenate([R_neg[:-1], R_pos])
    tau_completa = np.concatenate([-np.arange(k_max, 0, -1) * dt, np.arange(0, k_max + 1) * dt])

    return tau_completa, R_completa


# --- Generar una realización larga de X(t): 3000 puntos ---
n_puntos_largo = 3000
t_largo = np.linspace(0, 6, n_puntos_largo)   # duración de 6 s -> suficiente para tau hasta 2 s
dt = t_largo[1] - t_largo[0]

phi_unica = np.random.uniform(0, 2 * np.pi)   # una sola fase para esta realización
x_largo = A * np.cos(2 * np.pi * f0 * t_largo + phi_unica)

tau_empirica, R_X_empirica = autocorrelacion_empirica(x_largo, dt, tau_max=2)

# --- Comparación en un mismo gráfico ---
plt.figure(figsize=(12, 5))
plt.plot(tau_vals, R_X_teorica, color="red", linewidth=2, label="$R_X(\\tau)$ teórica")
plt.plot(tau_empirica, R_X_empirica, color="steelblue", linewidth=1, alpha=0.8,
         linestyle="--", label="$R_X(\\tau)$ empírica (1 realización, 3000 pts)")
plt.title("Autocorrelación de X(t): teórica vs empírica")
plt.xlabel(r"$\tau$ (s)")
plt.ylabel(r"$R_X(\tau)$")
plt.legend()
plt.grid(alpha=0.3)
plt.axhline(0, color="gray", linewidth=0.8)
plt.tight_layout()
plt.savefig("autocorrelacion_X_comparacion.png", dpi=150)
plt.show()

print("="*70)
print("AUTOCORRELACIÓN DE X(t)")
print("="*70)
print(f"R_X(0) teórica  = {autocorrelacion_teorica_X(0):.4f}   (= A²/2 = {A**2/2:.4f})")
idx_tau0 = np.argmin(np.abs(tau_empirica))
print(f"R_X(0) empírica = {R_X_empirica[idx_tau0]:.4f}")


