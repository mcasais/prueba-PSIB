# ========================================================================
# DESAFÍO ADICIONAL: Proceso con deriva Y(t) = X(t) + 0.5t
# ========================================================================

def autocorrelacion_teorica_Y(t1, t2, A=A, f0=f0):
    """
    Calcula R_Y(t1, t2) = E[Y(t1)Y(t2)] de forma analítica, donde
    Y(t) = X(t) + 0.5*t.

    Deducción:
    Y(t1)Y(t2) = [X(t1) + 0.5*t1][X(t2) + 0.5*t2]
               = X(t1)X(t2) + 0.5*t2*X(t1) + 0.5*t1*X(t2) + 0.25*t1*t2

    Tomando esperanza y usando que E[X(t)] = 0 para todo t:

        R_Y(t1, t2) = R_X(t1, t2) + 0.25 * t1 * t2
        R_Y(t1, t2) = (A^2/2) * cos(2*pi*f0*(t2 - t1)) + 0.25 * t1 * t2

    A diferencia de R_X, esta expresión NO depende solo de tau = t2 - t1,
    sino también de los valores absolutos de t1 y t2 (por el término
    0.25*t1*t2). Esto es la firma matemática de la NO estacionariedad.
    """
    tau = t2 - t1
    return (A**2 / 2) * np.cos(2 * np.pi * f0 * tau) + 0.25 * t1 * t2


# Comparamos R_Y(t1, t1+tau) para dos valores distintos de t1 (0 y 2)
# Si el proceso fuera estacionario, ambas curvas coincidirían.
t1_a = 0.0
t1_b = 2.0

R_Y_t1a = np.array([autocorrelacion_teorica_Y(t1_a, t1_a + tau) for tau in tau_vals])
R_Y_t1b = np.array([autocorrelacion_teorica_Y(t1_b, t1_b + tau) for tau in tau_vals])

plt.figure(figsize=(12, 5))
plt.plot(tau_vals, R_X_teorica, color="red", linewidth=2, linestyle=":",
         label="$R_X(\\tau)$ (referencia, proceso sin deriva)")
plt.plot(tau_vals, R_Y_t1a, color="darkorange", linewidth=2,
         label=f"$R_Y(t_1={t1_a}, t_1+\\tau)$")
plt.plot(tau_vals, R_Y_t1b, color="purple", linewidth=2,
         label=f"$R_Y(t_1={t1_b}, t_1+\\tau)$")
plt.title(r"Autocorrelación teórica de Y(t) para distintos valores de $t_1$")
plt.xlabel(r"$\tau$ (s)")
plt.ylabel(r"$R_Y(t_1, t_1+\tau)$")
plt.legend()
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig("autocorrelacion_Y_no_estacionaria.png", dpi=150)
plt.show()

# --- Autocorrelación empírica de Y(t) (aplicando el mismo método que a X) ---
y_largo = x_largo + 0.5 * t_largo
tau_empirica_Y, R_Y_empirica = autocorrelacion_empirica(y_largo, dt, tau_max=2)

plt.figure(figsize=(12, 5))
plt.plot(tau_vals, R_X_teorica, color="red", linestyle=":", label="$R_X(\\tau)$ (referencia)")
plt.plot(tau_empirica_Y, R_Y_empirica, color="seagreen", label="$R_Y(\\tau)$ empírica (1 realización)")
plt.title("Autocorrelación empírica de Y(t): el método de promedio temporal ya no es válido")
plt.xlabel(r"$\tau$ (s)")
plt.ylabel("Autocorrelación")
plt.legend()
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig("autocorrelacion_Y_empirica.png", dpi=150)
plt.show()

print("\n" + "="*70)
print("AUTOCORRELACIÓN DE Y(t) = X(t) + 0.5t")
print("="*70)
print(f"R_Y(t1=0, t2=0+tau=0)   = {autocorrelacion_teorica_Y(0, 0):.4f}")
print(f"R_Y(t1=2, t2=2+tau=0)   = {autocorrelacion_teorica_Y(2, 2):.4f}")
print("-> Ambos deberían ser iguales a R_X(0) si el proceso fuera estacionario;")
print("   sin embargo difieren porque incluyen el término 0.25*t1*t2.")


